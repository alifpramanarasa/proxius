{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxius",
  "version": "0.0.1",
  "identifier": "com.proxius.app",
  "build": {
    "frontendDist": "../../../ui/app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @proxius/app dev",
    "beforeBuildCommand": "pnpm --filter @proxius/app build"
  },
  "app": {
    "windows": [
      {
        "title": "Proxius",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
